# --- BroadcasTheNet (the only source Flix uses) ---
BTN_API_KEY=
# BTN_API_URL=https://api.broadcasthe.net/

# --- qBittorrent (the torrent engine; BTN only allows whitelisted clients) ---
QB_URL=http://127.0.0.1:8080
QB_USER=admin
QB_PASS=
# Must be the same path for Flix and qBittorrent (shared volume if containerised)
DOWNLOAD_DIR=./downloads

# Seeding is fixed at BTN's rule: 130 hours OR 1:1 ratio. It is not configurable.

# --- Content ratings and the IMDb score (automatic, never set by hand) ---
# Flix reads each show's TV-Y/TV-PG/TV-14/TV-MA rating and IMDb score from IMDb, through OMDb (free key: omdbapi.com).
# Shows with no rating known count as "Unrated".
OMDB_API_KEY=
# A free TMDB v3 API key is strongly recommended: it tells Flix which service each show is on (HBO, Crave, Showcase, Netflix,
# Disney+, Apple TV+, Paramount+), its language, how long each season is and what is trending, and is the fallback for content ratings.
TMDB_API_KEY=
# Backup artwork also comes from TVmaze (no key). Set TVMAZE_URL= (empty) to switch that off.

# --- App ---
PORT=8096
DATA_DIR=./data
# Treat a viewer as "gone" after N days of inactivity so one abandoned user can't pin a torrent forever (0 = never)
ABANDON_DAYS=30
# Refuse new downloads when less than this many GB of disk would be left
MIN_FREE_GB=10
# A show counts as watched only when it has played to the end (1). Lower it (e.g. 0.9) to count that much as watched.
WATCHED_THRESHOLD=1

# --- Redirect ---
# If set, every other address is redirected here (https://host:port).
# On Umbrel this stops the phone opening Flix on the proxy port, where the
# certificate only covers umbrel.local and always warns.
PUBLIC_URL=
