# --- BroadcasTheNet (the only source Flix uses) ---
BTN_API_KEY=
# BTN_API_URL=https://api.broadcasthe.net/

# --- qBittorrent (the torrent engine; BTN only allows whitelisted clients) ---
QB_URL=http://127.0.0.1:8080
QB_USER=admin
QB_PASS=
# The port qBittorrent listens on for peers. Fixed (not random) so a port forward on your router keeps working across restarts.
# Anything that must reach it has to use this same number: docker-compose publishes it, and UPnP asks the router to open it.
# QB_LISTEN_PORT=6881
# Where torrents are saved. Leave blank to use your desktop's Downloads folder (~/Downloads, or XDG_DOWNLOAD_DIR as on XFCE).
# Must be the same path for Flix and qBittorrent (shared volume if containerised)
# DOWNLOAD_DIR=/path/to/Downloads

# Seeding is fixed at BTN's rule: 130 hours OR 1:1 ratio. It is not configurable.

# --- Content ratings and the IMDb score (automatic, never set by hand) ---
# Flix reads each show's TV-Y/TV-PG/TV-14/TV-MA rating and IMDb score from IMDb, through OMDb (free key: omdbapi.com).
# Shows with no rating known count as "Unrated".
OMDB_API_KEY=
# A free TMDB v3 API key is strongly recommended: it tells Flix which service each show is on (HBO, Crave, Showcase, Netflix,
# Disney+, Apple TV+, Paramount+), its language, how long each season is and what is trending, and is the fallback for content ratings.
TMDB_API_KEY=
# Backup artwork also comes from TVmaze (no key). Set TVMAZE_URL= (empty) to switch that off.

# --- App ---
PORT=8096
DATA_DIR=./data
# Treat a viewer as "gone" after N days of inactivity so one abandoned user can't pin a torrent forever (0 = never)
ABANDON_DAYS=14
# Days a finished, fully seeded season pack that some allowed viewers never opened shows as "Leaving soon" before it is removed (0 = off).
LEAVING_DAYS=7
# Refuse new downloads when less than this many GB (or this % of the disk, whichever is more) would be left
MIN_FREE_GB=10
MIN_FREE_PCT=10
# Warn the admin below this % free
WARN_FREE_PCT=20
# Downloading ahead of time (next episode, My List, new episodes). Cautious on purpose: every download must seed 130 h / 1:1 before it can be deleted.
AUTO_DOWNLOADS=true
AUTO_PAUSE_FREE_PCT=25
AUTO_PER_USER=3
AUTO_EXPIRE_DAYS=7
# A show counts as watched once this much of it has played (0.92 = 92%), because intros and end credits are never watched, so an
# episode would otherwise never be "finished" and its files never freed. 1 means played to the very end.
WATCHED_THRESHOLD=0.92

# --- Redirect ---
# If set, every other address is redirected here (https://host:port).
# On Umbrel this stops the phone opening Flix on the proxy port, where the
# certificate only covers umbrel.local and always warns.
PUBLIC_URL=

# --- Cast to a TV ---
# The address this machine has on the home network (http://192.168.1.20:8096).
# A Chromecast or Google TV fetches the video itself, and it cannot reach the
# Umbrel proxy, so the player hands it this address instead. Leave it empty and
# the Cast button never appears.
LAN_URL=
