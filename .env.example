# --- BroadcasTheNet (the only source Flix uses) ---
BTN_API_KEY=
# BTN_API_URL=https://api.broadcasthe.net/

# --- qBittorrent (the torrent engine; BTN only allows whitelisted clients) ---
QB_URL=http://127.0.0.1:8080
QB_USER=admin
QB_PASS=
# Must be the same path for Flix and qBittorrent (shared volume if containerised)
DOWNLOAD_DIR=./downloads

# Seeding is fixed at BTN's rule: 130 hours OR 1:1 ratio. It is not configurable.

# --- Content ratings (optional) ---
# A free TMDB v3 API key lets Flix look up TV-Y/TV-PG/TV-14/TV-MA automatically.
# Without it, an admin sets each show's rating by hand (shows with no rating count as "Unrated").
TMDB_API_KEY=
# Backup artwork also comes from TVmaze (no key). Set TVMAZE_URL= (empty) to switch that off.

# --- App ---
PORT=8096
DATA_DIR=./data
# Treat a viewer as "gone" after N days of inactivity so one abandoned user can't pin a torrent forever (0 = never)
ABANDON_DAYS=30
# Refuse new downloads when less than this many GB of disk would be left
MIN_FREE_GB=10
WATCHED_THRESHOLD=0.9
