<?xml version="1.0" encoding="utf-8"?>
<!-- The white mark from public/icon.svg: the F's two stadium bars and the play triangle, centred in the safe zone.
     As a vector it stays sharp at every density, which is what a legacy bitmap in a launcher's white circle never was. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <!-- the upright of the F -->
    <path
        android:fillColor="#ffffff"
        android:pathData="M140,154 A38,38 0 0 1 216,154 L216,358 A38,38 0 0 1 140,358 Z" />
    <!-- its top arm -->
    <path
        android:fillColor="#ffffff"
        android:pathData="M178,116 A38,38 0 0 0 178,192 L334,192 A38,38 0 0 0 334,116 Z" />
    <!-- the play triangle, at the scale the icon gives it -->
    <group
        android:scaleX="0.906"
        android:scaleY="0.906"
        android:pivotX="242"
        android:pivotY="287">
        <path
            android:fillColor="#ffffff"
            android:pathData="M242 228c0-16 17-26 31-18l102 59c14 8 14 28 0 36l-102 59c-14 8-31-2-31-18z" />
    </group>
</vector>
