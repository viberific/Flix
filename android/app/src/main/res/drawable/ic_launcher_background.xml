<?xml version="1.0" encoding="utf-8"?>
<!-- The Flix tile's own gradient, filling the whole adaptive-icon canvas; the launcher masks its own shape out of it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <path android:pathData="M0,0h512v512h-512z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="512"
                android:endY="512"
                android:startColor="#ff8a4c"
                android:centerColor="#ff3d6e"
                android:endColor="#b8155a" />
        </aapt:attr>
    </path>
    <!-- The soft sheen: radial from the top-left quarter, widening over the whole canvas, exactly as public/icon.svg paints it
         (cx .25 cy 0 r 1 on a 512 box, white at 32% fading out by half the radius). -->
    <path android:pathData="M0,0h512v512h-512z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="128"
                android:centerY="0"
                android:gradientRadius="512"
                android:startColor="#52ffffff"
                android:centerColor="#00ffffff"
                android:endColor="#00ffffff" />
        </aapt:attr>
    </path>
</vector>
