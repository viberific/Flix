{
  "name": "flix",
  "version": "0.3.46",
  "private": true,
  "type": "module",
  "description": "Jellyfin-style media server that uses BroadcasTheNet as its only source and streams torrents on demand",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:unit": "node --import tsx --test --test-concurrency=1 test/unit.test.ts test/btn.test.ts test/redirect.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "hls.js": "^1.7.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "bittorrent-tracker": "^11.2.3",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "webtorrent": "^3.0.21"
  }
}
